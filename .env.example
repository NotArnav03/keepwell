# Copy to .env and fill in yourself. Never commit .env, never paste values into chat or code.
# Hosted environments set these in Render, not from a file.

# --- Runtime (M1) ---
NODE_ENV=development          # development | test | production
APP_ENV=local                 # local | staging | prod-demo
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# --- Database (M1): your own Neon branch ---
# `neon env pull` (or `neon deploy`) fills these. The API uses the UNPOOLED (direct) one and refuses
# a -pooler host: the job queue, advisory locks and LISTEN/NOTIFY need a real session.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# --- PayPal, SANDBOX ONLY (M1) ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set to true to use packages/paypal-mock instead of the sandbox.
PAYPAL_USE_MOCK=true

# --- Anthropic (M2) ---
ANTHROPIC_API_KEY=
# Our own guard on top of the console spend limit.
LLM_DAILY_BUDGET_USD=5

# --- Auth and tokens (M3 subscriber side, M4 merchant side) ---
# Long random strings, different per environment.
SESSION_SECRET=
WIDGET_TOKEN_SECRET=
MAGIC_LINK_SECRET=

# --- Email and errors (M5, M1) ---
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=

# --- Public URLs (used for links, CORS and PayPal return URLs) ---
API_PUBLIC_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174
JUDGE_URL=http://localhost:5175
DEMO_STORE_URL=http://localhost:5176
WIDGET_CDN_URL=http://localhost:5177
