{
  "name": "@keepwell/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "dev:fake-sessions": "node --env-file-if-exists=../../.env --watch --import tsx src/modules/sessions/fake-server.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts",
    "spike": "node --env-file-if-exists=../../.env --import tsx src/cli/sandbox-spike.ts",
    "pool:refill": "node --env-file-if-exists=../../.env --import tsx src/cli/pool-refill.ts",
    "eval": "node --env-file-if-exists=../../.env --import tsx src/modules/agent/evals/cli.ts",
    "merchant:user": "node --env-file-if-exists=../../.env --import tsx src/cli/merchant-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@keepwell/contracts": "workspace:*",
    "@keepwell/db": "workspace:*",
    "@keepwell/evals": "workspace:*",
    "@keepwell/policy": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/node": "11.8.0",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@keepwell/paypal-mock": "workspace:*",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
