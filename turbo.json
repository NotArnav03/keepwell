{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["KEEPWELL_TEST_DATABASE_URL", "KEEPWELL_REQUIRE_DATABASE_TESTS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
